rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user exists in the staff whitelist
    function isWhitelistedStaff() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/sais_users/$(request.auth.uid));
    }

    // Get the user's role from the whitelist
    function staffRole() {
      return get(/databases/$(database)/documents/sais_users/$(request.auth.uid)).data.role;
    }

    function isHeadteacher() {
      return isWhitelistedStaff() && staffRole() == 'headteacher';
    }

    // --- Staff whitelist ---
    match /sais_users/{userId} {
      // Users can read their own profile. Whitelisted staff can read all profiles to assign teachers.
      allow read: if isWhitelistedStaff() || (request.auth != null && request.auth.uid == userId);
      
      // Staff can only update name, schoolId and subjects, preventing role escalation or email changes.
      allow update: if isWhitelistedStaff() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'schoolId', 'subjects']);
                    
      // Only admins (via Firebase Console/Admin SDK) can add new staff or delete staff
      allow create, delete: if false;
    }

    // --- Schools ---
    match /sais_schools/{schoolId} {
      allow read: if isWhitelistedStaff();
      allow write: if isHeadteacher();
    }

    // --- Classes / Streams ---
    match /sais_classes/{classId} {
      allow read: if isWhitelistedStaff();
      allow write: if isHeadteacher();
    }

    match /classStreams/{classId} {
      allow read: if isWhitelistedStaff();
      allow write: if isHeadteacher();
    }

    // --- Student data (scores, enrollments, contacts, summaries) ---
    function isFormTeacher(classId) {
      return get(/databases/$(database)/documents/classStreams/$(classId)).data.teacherId == request.auth.uid;
    }

    function isSubjectTeacher(subjectCode) {
      return subjectCode in get(/databases/$(database)/documents/sais_users/$(request.auth.uid)).data.subjects;
    }

    function isYearArchived(yearString) {
      let yearId = yearString.replace('/', '-');
      let doc = get(/databases/$(database)/documents/academicYears/$(yearId));
      return doc != null && doc.data.status == 'archived';
    }

    match /sais_scores/{scoreId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff() && (
        isHeadteacher() || 
        (!isYearArchived(request.resource.data.academicYear) && (isFormTeacher(request.resource.data.classId) || isSubjectTeacher(request.resource.data.subjectCode)))
      );
    }

    match /sais_classEnrollments/{enrollmentId} {
      allow read: if isWhitelistedStaff();
      allow write: if isHeadteacher() || isFormTeacher(request.resource.data.classId);
    }

    match /sais_lifelongStudents/{studentId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff();
    }

    match /sais_reportSummaries/{summaryId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff() && (
        isHeadteacher() || 
        (!isYearArchived(request.resource.data.academicYear) && isFormTeacher(request.resource.data.classId))
      );
    }

    match /sais_contacts/{contactId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff();
    }

    // --- AI/comment context ---
    match /sais_subject_contexts/{contextId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff();
    }

    match /sais_banned_tokens/{tokenId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff();
    }

    // --- System singletons (active class, key sequences) ---
    match /sais_active_class/{docId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff();
    }

    match /sais_key_seq/{docId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff();
    }

    // --- System metadata (cache timestamps) ---
    match /system/{docId} {
      allow read: if isWhitelistedStaff();
      allow write: if isWhitelistedStaff();
    }

    // --- Academic year management ---
    match /academicYears/{yearId} {
      allow read: if isWhitelistedStaff();
      allow write: if isHeadteacher();
    }

    match /terms/{termId} {
      allow read: if isWhitelistedStaff();
      allow write: if isHeadteacher();
    }

    match /systemSettings/{settingId} {
      allow read: if isWhitelistedStaff();
      allow write: if isHeadteacher();
    }

    // --- Deny-by-default: any unlisted collection is blocked ---
    // (No wildcard match/{document=**} rule)
  }
}
